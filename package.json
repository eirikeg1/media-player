{
  "name": "media-player",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "REACT_NATIVE_PACKAGER_HOSTNAME=$(hostname -I | awk '{print $1}') APP_VARIANT=development expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_VARIANT=development bash scripts/expo-run.sh android --device",
    "android:release": "bash scripts/expo-run.sh android --variant release --device",
    "ios": "APP_VARIANT=development bash scripts/expo-run.sh ios --device",
    "ios:release": "bash scripts/expo-run.sh ios --configuration Release --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rn-primitives/portal": "^1.3.0",
    "@shopify/flash-list": "^2.1.0",
    "@types/react-native-snap-carousel": "^3.8.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.13",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.9",
    "expo-crypto": "^15.0.7",
    "expo-dev-client": "~6.0.15",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.9",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-m3u-parser": "file:./native/rust-backend/modules/expo-m3u-parser",
    "expo-router": "~6.0.11",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-video": "~3.0.11",
    "expo-web-browser": "~15.0.8",
    "iptv-playlist-parser": "^0.15.1",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "wa-sqlite": "^1.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
